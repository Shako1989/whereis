# Copy to .env for docker-compose / local runs. Never commit .env.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/whereis
DB_USERNAME=whereis
DB_PASSWORD=whereis
POSTGRES_PORT=5432

# MinIO
MINIO_ENDPOINT=http://localhost:9000
# Endpoint browsers can reach for presigned URLs (defaults to MINIO_ENDPOINT)
MINIO_EXTERNAL_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=item-images
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT — must be at least 32 bytes
JWT_SECRET=change-me-to-a-random-32+-byte-secret-value

# AI assistant: mock (default, no key needed), openai (any OpenAI-compatible endpoint),
# or claude (Anthropic Messages API — reads the AI_CLAUDE_* block below, not AI_API_KEY)
AI_PROVIDER=mock

# openai provider
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.0
AI_TIMEOUT=30s
AI_MAX_OUTPUT_TOKENS=800

# claude provider — required when AI_PROVIDER=claude (get a key from console.anthropic.com
# and set a spend limit on it: the app has no per-user AI quota).
AI_CLAUDE_API_KEY=
AI_CLAUDE_MODEL=claude-haiku-4-5
# Leave blank for https://api.anthropic.com
AI_CLAUDE_BASE_URL=
# Only for an identity-linked key (400 "anthropic-workspace-id is required" without it).
AI_CLAUDE_WORKSPACE_ID=
# Sampling is accepted by Haiku 4.5, Opus 4.6 and Sonnet 4.6. Opus 4.7 and later, Sonnet 5 and
# the Fable family reject it with a 400 — leave this blank on those models and the parameter is
# dropped from the request instead of being sent and refused.
AI_CLAUDE_TEMPERATURE=0.0
AI_CLAUDE_TIMEOUT=15s
AI_CLAUDE_MAX_OUTPUT_TOKENS=4096
AI_CLAUDE_MAX_RETRIES=1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
