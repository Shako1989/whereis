# Copy to .env for docker-compose / local runs. Never commit .env.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/whereis
DB_USERNAME=whereis
DB_PASSWORD=whereis
POSTGRES_PORT=5432

# MinIO
MINIO_ENDPOINT=http://localhost:9000
# Endpoint browsers can reach for presigned URLs (defaults to MINIO_ENDPOINT)
MINIO_EXTERNAL_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=item-images
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT — must be at least 32 bytes
JWT_SECRET=change-me-to-a-random-32+-byte-secret-value

# AI assistant: mock (default, no key needed) or openai (any OpenAI-compatible endpoint)
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
