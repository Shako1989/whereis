# Append these two vhosts to autoparts-api/deploy/Caddyfile, then add
#   WHEREIS_API_HOST: ${WHEREIS_API_HOST}
#   WHEREIS_MEDIA_HOST: ${WHEREIS_MEDIA_HOST}
# to that stack's `caddy` service `environment:` block and define both in its .env.
# Reload without downtime:
#   docker exec autoparts-caddy caddy reload --config /etc/caddy/Caddyfile

# ---- whereis API ----
{$WHEREIS_API_HOST} {
    encode zstd gzip

    # THE RTDN PUSH ENDPOINT'S ACCESS LOG MUST NOT CARRY ITS QUERY STRING.
    #
    # POST /play/rtdn?key=<32 random bytes> is Google Pub/Sub's push URL, and that `key` is one of
    # the endpoint's TWO authentication checks (the other is Google's OIDC push token, verified in
    # the app). A URL query string is the single most commonly logged secret there is: Caddy's
    # default access log records the full URI, so without this block the shared secret is written
    # to disk on every notification, then archived by the nightly backup, then read by anyone who
    # can read a log.
    #
    # `log_skip` drops the request from the access log entirely, which is the only option that
    # cannot leak the value by accident (a redaction filter that stops matching after a Caddy
    # upgrade fails silently and in the wrong direction). Nothing of value is lost: the ledger table
    # play_notifications records every notification the app actually received, with what it decided,
    # which is strictly more useful than an access-log line.
    #
    # IF THIS IS LEFT UNDONE the endpoint still works and still authenticates — check 2 is
    # unaffected — so nothing breaks loudly. That is exactly why it is written here rather than
    # left to be remembered.
    @rtdn path /play/rtdn
    log_skip @rtdn

    reverse_proxy whereis-api:8080 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        # OVERWRITE, never append — and this line is load-bearing, not hygiene.
        #
        # reverse_proxy's DEFAULT is to APPEND the peer to whatever X-Forwarded-For the client
        # sent, and Spring's ForwardedHeaderFilter (server.forward-headers-strategy: framework in
        # application-prod.yml) takes the FIRST entry. So without this, any caller sets
        # `X-Forwarded-For: 1.2.3.4` and becomes a different client on every request: the
        # marketplace board's per-IP rate limiter is bypassed with one line of curl, and the
        # request log has been recording a spoofable address all along.
        header_up X-Forwarded-For {remote_host}
    }
}

# ---- whereis item photos ----
#
# ONE vhost, TWO classes of object, and the difference is the bucket in the path:
#
#   /$WHEREIS_MINIO_BUCKET/u/...         PRIVATE. One object per uploaded item photo, fetched
#                                        through a presigned GET (MINIO_PRESIGN_TTL, 10 min) minted
#                                        by the API. MinIO validates the SigV4 signature on each
#                                        request, so Caddy needs no authorization logic of its own.
#
#   /$WHEREIS_MINIO_PUBLIC_BUCKET/p/...  PUBLIC (V14). The metadata-stripped copy of a published
#                                        marketplace listing's photo, at a PERMANENT unsigned
#                                        address. The bucket carries an anonymous s3:GetObject
#                                        policy — and deliberately NOT s3:ListBucket, so the opaque
#                                        p/{uuid} keys cannot be enumerated (README Step 4b).
#                                        The object carries its own `Cache-Control: public,
#                                        max-age=86400`, set by the API at PUT time, so this vhost
#                                        needs no per-path knowledge to make it cacheable and a CDN
#                                        can be put in front unchanged.
#
# GET/HEAD only: uploads go through the API's multipart endpoint, never a presigned PUT, so there is
# no write path to expose here.
#
# No CORS block: the client is native Android and sends no Origin. Add one only if a browser client
# is introduced.
{$WHEREIS_MEDIA_HOST} {
    encode zstd gzip

    # NO ACCESS LOG ON THIS VHOST, AND THIS IS A FIX RATHER THAN A PREFERENCE.
    #
    # Caddy's default access log records the full URI. On this vhost that URI is, for every private
    # photo, `/{bucket}/u/{userId}/i/{itemId}/{fileId}?X-Amz-Credential=...&X-Amz-Signature=...`.
    # So without this the log has been writing BOTH halves of the thing the marketplace design
    # works hardest to keep apart — the seller's user UUID and the item UUID — plus a live SigV4
    # signature, to disk on every image fetch, and then the nightly backup has been archiving it.
    # The signature expires in ten minutes; the user and item ids do not expire at all, and a log
    # of them is a ready-made map from one account to everything it owns.
    #
    # `log_skip` is the same answer, for the same reason, as the /play/rtdn block above: a redaction
    # filter that stops matching after a Caddy upgrade fails silently and in the wrong direction,
    # while dropping the line cannot leak the value by accident. Little of value is lost — MinIO
    # keeps its own access log, and the API's request log records the presign that preceded the
    # fetch.
    #
    # The matcher form is used rather than a bare `log_skip` because it is the form already proven
    # in this file.
    @media path /*
    log_skip @media

    @read method GET HEAD
    handle @read {
        reverse_proxy minio:9000 {
            # SigV4 signs the Host header. MinIO must see the same public hostname
            # the presigner used, not the docker-internal minio:9000 — otherwise
            # every image 403s with SignatureDoesNotMatch. The public bucket needs no
            # signature, so this is harmless there and required here.
            header_up Host {host}
        }
    }

    respond 405
}
