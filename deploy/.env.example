# Copy to .env on the VM and fill in real values. Never commit .env.
# All secrets: openssl rand -base64 32

# ---- Public hostnames (must have A records pointing at the VM, DNS-only) ----
WHEREIS_API_HOST=api.whereis.example.com
WHEREIS_MEDIA_HOST=files.whereis.example.com

# ---- Shared Docker network created by the AutoParts stack ----
# Verify the real name with: docker network ls
SHARED_NETWORK=deploy_default

# ---- Database (a separate database inside the EXISTING autoparts-postgres) ----
WHEREIS_DB_NAME=whereis
WHEREIS_DB_USER=whereis
WHEREIS_DB_PASSWORD=

# ---- MinIO (a private bucket + scoped user inside the EXISTING autoparts-minio) ----
WHEREIS_MINIO_BUCKET=whereis-item-images
WHEREIS_MINIO_ACCESS_KEY=whereis
WHEREIS_MINIO_SECRET_KEY=

# ---- MinIO: the PUBLIC bucket for published marketplace photos (V14) ----
# LEAVE THIS BLANK TO DEPLOY TODAY. Blank means published photos are switched off: listings publish
# and the anonymous board serves them WITHOUT an image. Nothing fails to start, nothing 500s, and
# every other feature is untouched — the same deliberate deployable state as the Play Billing block
# further down.
#
# Set it only after README Step 4b has created the bucket AND applied an anonymous s3:GetObject
# policy to it. The application never creates this bucket, on purpose: it cannot grant that policy,
# and a bucket without it makes every listing image 403 with nothing in the log saying why. With
# the name set and the bucket absent, publishing answers 502 and the startup log WARNs.
#
# It must NOT be the same bucket as WHEREIS_MINIO_BUCKET. Anonymous read is granted per BUCKET, so
# one bucket for both would publish every private item photo the moment the policy was applied; the
# application refuses to start on that rather than let it happen.
#
# WHAT LIVES IN IT: one object per published listing photo, at an opaque `p/{uuid}` key, with every
# scrap of camera metadata removed (GPS coordinates, capture time, device make/model/serial). The
# URL is permanent and unsigned, so a browser and a CDN can cache it — which is the whole reason for
# a second bucket. The originals stay private and keep their metadata.
# WHEREIS_MINIO_PUBLIC_BUCKET=whereis-public-images

# ---- JWT: at least 32 bytes. openssl rand -base64 48 ----
# Rotating this invalidates access tokens but NOT refresh tokens (those are opaque
# values stored SHA-256-hashed in Postgres), so users stay logged in.
WHEREIS_JWT_SECRET=

# ---- AI assistant: mock (no key, fully functional), openai, or claude ----
WHEREIS_AI_PROVIDER=mock

# openai provider
WHEREIS_AI_BASE_URL=https://api.openai.com/v1
WHEREIS_AI_API_KEY=
WHEREIS_AI_MODEL=gpt-4o-mini

# claude provider (Anthropic Messages API). WHEREIS_AI_CLAUDE_API_KEY is REQUIRED when
# WHEREIS_AI_PROVIDER=claude — the container exits at startup without it. Set a spend limit
# on the Anthropic key: the app has no per-user AI quota, so an authenticated user can loop
# /assistant/remember. Haiku 4.5 costs roughly $0.0015 per remember call, less for a search.
WHEREIS_AI_CLAUDE_API_KEY=
WHEREIS_AI_CLAUDE_MODEL=claude-haiku-4-5
# Leave BLANK when raising the model to one that rejects sampling parameters (Opus 4.7+,
# Sonnet 5, Fable); blank drops the parameter instead of sending a value the API refuses.
WHEREIS_AI_CLAUDE_TEMPERATURE=0.0
WHEREIS_AI_CLAUDE_TIMEOUT=15s
WHEREIS_AI_CLAUDE_MAX_OUTPUT_TOKENS=4096
# Blank means the SDK's own https://api.anthropic.com; set it only for a gateway or proxy.
WHEREIS_AI_CLAUDE_BASE_URL=
# Only for an identity-linked key; a workspace-scoped key must leave this blank.
WHEREIS_AI_CLAUDE_WORKSPACE_ID=
WHEREIS_AI_CLAUDE_MAX_RETRIES=1

# ---- The facts the two public legal pages state ----
# All five are REQUIRED: the app refuses to start without them, and every one is rendered into
# /legal/privacy and /legal/delete-account, which Google Play cross-checks against the Data safety
# declaration. There are no defaults on purpose — a default would put a value nobody chose onto a
# public page.
WHEREIS_LEGAL_SUPPORT_EMAIL=you@example.com
WHEREIS_LEGAL_ENTITY=Your Full Name
WHEREIS_LEGAL_ADDRESS=Street, City, Postcode, Country
# The date the current wording took effect, ISO-8601.
WHEREIS_LEGAL_EFFECTIVE_DATE=2026-09-20
# How long a deleted row survives in the nightly backups. MUST match what db_backup.sh actually
# rotates (RETENTION_DAYS in that script), because this number is the promise the page makes.
WHEREIS_LEGAL_BACKUP_RETENTION_DAYS=14

# How long a Google purchase token is kept after an account is deleted, while the Play cancellation
# is retried. STATED ON THE PUBLIC ACCOUNT-DELETION PAGE in both languages, and read by
# PlayCancellationJanitor as its give-up deadline — one value, so the page cannot lie.
WHEREIS_LEGAL_CANCELLATION_RETRY_DAYS=7

# How long a Google Play billing notification stays in the RTDN ledger (play_notifications).
# STATED ON BOTH PUBLIC PAGES in both languages, and read by PlayNotificationJanitor as its cutoff
# — one value, so the page cannot lie. MUST stay above 7: Pub/Sub retains an unacknowledged message
# for up to 7 days, and the ledger's primary key is what makes a redelivery a no-op. The app
# refuses to start on a smaller value rather than quietly re-applying a notification.
WHEREIS_LEGAL_BILLING_LOG_RETENTION_DAYS=30

# ---- Play Billing: OFF by default, and that is a deliberate deployable state ----
#
# LEAVE THIS WHOLE BLOCK ALONE TO DEPLOY TODAY. Every variable below is optional; with none of
# them set the app runs `whereis.play.provider=disabled`, which means:
#   * POST /users/me/plan/purchases answers 501 PLAY_BILLING_NOT_CONFIGURED (the client keeps the
#     token — it is accepted once billing is switched on),
#   * POST /play/rtdn rejects every caller with 401 and writes no ledger row,
#   * the reconciler, the voided-purchase sweep and the cancellation janitor do not run,
#   * and so nothing can grant a tier by any route.
# Everything non-billing is unaffected: the free tier, GET /users/me/plan, the per-tier limits and
# 409 PLAN_LIMIT_REACHED all work exactly as they do with billing on.
#
# This exists because the values below CANNOT EXIST YET — no Google Cloud service account, no
# Pub/Sub topic, no Play Console product — and docker-compose.prod.yml used to mark them
# `:?`-required, so `docker compose up -d` took the whole application down over a feature nobody
# could use. It no longer does; the application itself now refuses to start on a
# HALF-configured billing setup, which is the case that actually matters (see below).
#
# `fake` is the deterministic offline provider used by every test. It is REFUSED under the prod
# profile — its tokens are guessable literals (`fake-active-max`), so a production process running
# it would grant the top tier to anyone who posted one. If you hit a boot failure, the answer is
# `disabled`, never `fake`.

# ---- Switching billing ON (README Step 11e) ----
# Set ALL SIX of these together, then `docker compose ... up -d`. No rebuild, no code change.
#
# THE APPLICATION REFUSES TO START, naming the property, if you get this half-right:
#   * WHEREIS_PLAY_PROVIDER=google with a blank service-account key
#   * WHEREIS_PLAY_RTDN_VERIFIER=google with a blank shared secret, audience or service-account
#     email (blank REJECTS every push rather than skipping the check, so this would silently stop
#     the deployment tracking Google — the worst failure mode in the design)
#   * `disabled` on only one of PROVIDER / RTDN_VERIFIER. A live Play API with a dead push endpoint
#     means a refunded subscriber keeps a paid tier; a live push endpoint with no Play API behind
#     it means a 500 per delivery that can never succeed.
#
# WHEREIS_PLAY_PROVIDER=google
# WHEREIS_PLAY_PACKAGE_NAME=az.technest.whereis
#   The service-account key CONTENTS, on one line. NOTE: this file lives on the VM's only disk and
#   the nightly backup archives it — a Play publishing credential in an unencrypted backup on the
#   same box is a different risk class from a database password. See docs/BACKEND_REQUESTS.md BR-12.
# WHEREIS_PLAY_SERVICE_ACCOUNT_JSON=
#
# The Pub/Sub push endpoint is POST https://<WHEREIS_API_HOST>/play/rtdn?key=<shared secret>. It
# can hand ANY account ANY tier and it is reachable by anyone on the internet, so it gets TWO
# INDEPENDENT checks and both must pass.
#
# 1) The shared secret, which is the ?key= of the push URL registered in the Play Console.
#    Generate it and NEVER reuse another secret:
#        openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
#    Caddy must not log it: deploy/Caddyfile.whereis has `log_skip` for /play/rtdn. If that is
#    left undone, this secret is written to disk on every notification and archived by the nightly
#    backup, and check 2 becomes the only real defence.
# WHEREIS_PLAY_RTDN_SHARED_SECRET=
# 2) Google's OIDC push token. `google` verifies it; `fake` accepts one literal and is REFUSED
#    under the prod profile; `disabled` (the default) denies every caller.
# WHEREIS_PLAY_RTDN_VERIFIER=google
#   The `aud` claim. MUST be the opaque audience you set EXPLICITLY on the Pub/Sub push
#   subscription (see README Step 11) — never the push URL. Left blank in the Console, Google sets
#   `aud` to the full endpoint URL including ?key=<the secret above>, and the app refuses to boot
#   on a URL-shaped value rather than let you paste a secret into configuration and every log.
# WHEREIS_PLAY_RTDN_AUDIENCE=whereis-rtdn
#   The `email` claim: the service account the push subscription signs with.
# WHEREIS_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# The three scheduled billing components (drift reconciler, refund sweep, cancellation janitor).
# ON by default, and IRRELEVANT while billing is disabled — the jobs check that first and do nothing.
# Turn them OFF on every container but one if whereis is ever scaled out: correctness survives, the
# Play quota spend doubles.
# WHEREIS_PLAY_RECONCILE_ENABLED=true
# WHEREIS_PLAY_VOIDED_SWEEP_ENABLED=true
# WHEREIS_PLAY_CANCELLATION_ENABLED=true

# ---- Tier limits (optional; see README Step 10) ----
# The numbers in application.yml ARE the product rule, so these are normally unset. They are also
# NOT forwarded by docker-compose.prod.yml by default. If you do use them, remember that the ladder
# must never go down: raising a LOWER tier means raising every tier above it, or startup fails with
# a message naming both keys. The old WHEREIS_LIMITS_FREE_* names bind NOTHING and are now a
# startup failure in their own right.
# WHEREIS_PLANS_FREE_SPACES=1
# WHEREIS_PLANS_FREE_ITEMS=100

# ---- Resources ----
WHEREIS_MEM_LIMIT=768m

# ---- Public marketplace board (V12) ----
# Per-IP budgets for the only endpoints reachable without a JWT. Defaults are fine; raise only if
# a real client is being throttled. See deploy/README.md Step 12a for the Caddy line these depend on.
WHEREIS_MARKET_READS_PER_MINUTE=30
WHEREIS_MARKET_REPORTS_PER_HOUR=5

# ---- Seller-level moderation (V13) ----
# WHO MAY BLOCK A SELLER, comma-separated. FAILS CLOSED: left blank — which is how it ships — NOBODY
# may moderate and every call to /api/v1/moderation/** answers 403 NOT_A_MODERATOR. There is no role
# column in this schema; each address must belong to an account that exists and can log in, because
# the operator's own JWT is the credential and their e-mail is what lands in blocked_sellers
# .blocked_by. Google Play's user-generated-content policy requires the ability to block a user, so
# SET THIS before the marketplace is in front of real users. deploy/README.md Step 12e is the
# procedure.
WHEREIS_MARKETPLACE_MODERATOR_EMAILS=
