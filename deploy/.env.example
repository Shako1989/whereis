# Copy to .env on the VM and fill in real values. Never commit .env.
# All secrets: openssl rand -base64 32

# ---- Public hostnames (must have A records pointing at the VM, DNS-only) ----
WHEREIS_API_HOST=api.whereis.example.com
WHEREIS_MEDIA_HOST=files.whereis.example.com

# ---- Shared Docker network created by the AutoParts stack ----
# Verify the real name with: docker network ls
SHARED_NETWORK=deploy_default

# ---- Database (a separate database inside the EXISTING autoparts-postgres) ----
WHEREIS_DB_NAME=whereis
WHEREIS_DB_USER=whereis
WHEREIS_DB_PASSWORD=

# ---- MinIO (a private bucket + scoped user inside the EXISTING autoparts-minio) ----
WHEREIS_MINIO_BUCKET=whereis-item-images
WHEREIS_MINIO_ACCESS_KEY=whereis
WHEREIS_MINIO_SECRET_KEY=

# ---- JWT: at least 32 bytes. openssl rand -base64 48 ----
# Rotating this invalidates access tokens but NOT refresh tokens (those are opaque
# values stored SHA-256-hashed in Postgres), so users stay logged in.
WHEREIS_JWT_SECRET=

# ---- AI assistant: mock (no key, fully functional), openai, or claude ----
WHEREIS_AI_PROVIDER=mock

# openai provider
WHEREIS_AI_BASE_URL=https://api.openai.com/v1
WHEREIS_AI_API_KEY=
WHEREIS_AI_MODEL=gpt-4o-mini

# claude provider (Anthropic Messages API). WHEREIS_AI_CLAUDE_API_KEY is REQUIRED when
# WHEREIS_AI_PROVIDER=claude — the container exits at startup without it. Set a spend limit
# on the Anthropic key: the app has no per-user AI quota, so an authenticated user can loop
# /assistant/remember. Haiku 4.5 costs roughly $0.0015 per remember call, less for a search.
WHEREIS_AI_CLAUDE_API_KEY=
WHEREIS_AI_CLAUDE_MODEL=claude-haiku-4-5
# Leave BLANK when raising the model to one that rejects sampling parameters (Opus 4.7+,
# Sonnet 5, Fable); blank drops the parameter instead of sending a value the API refuses.
WHEREIS_AI_CLAUDE_TEMPERATURE=0.0
WHEREIS_AI_CLAUDE_TIMEOUT=15s
WHEREIS_AI_CLAUDE_MAX_OUTPUT_TOKENS=4096
# Blank means the SDK's own https://api.anthropic.com; set it only for a gateway or proxy.
WHEREIS_AI_CLAUDE_BASE_URL=
# Only for an identity-linked key; a workspace-scoped key must leave this blank.
WHEREIS_AI_CLAUDE_WORKSPACE_ID=
WHEREIS_AI_CLAUDE_MAX_RETRIES=1

# How long a Google purchase token is kept after an account is deleted, while the Play cancellation
# is retried. STATED ON THE PUBLIC ACCOUNT-DELETION PAGE in both languages, and read by
# PlayCancellationJanitor as its give-up deadline — one value, so the page cannot lie.
WHEREIS_LEGAL_CANCELLATION_RETRY_DAYS=7

# ---- Play Billing (V10) ----
# All three are REQUIRED under the prod profile: docker-compose.prod.yml forwards them with `:?`,
# so the stack refuses to start rather than hand the app a value it would fail startup on anyway.
#
# `fake` is the deterministic offline provider used by every test. It is REFUSED under the prod
# profile — its tokens are guessable literals, so a production process running it would grant the
# top tier to anyone who posted one. Set `google` and supply the service-account key.
WHEREIS_PLAY_PROVIDER=google
WHEREIS_PLAY_PACKAGE_NAME=az.technest.whereis
# The service-account key CONTENTS, on one line. NOTE: this file lives on the VM's only disk and
# the nightly backup archives it — a Play publishing credential in an unencrypted backup on the
# same box is a different risk class from a database password. See the open questions in
# docs/BACKEND_REQUESTS.md BR-12.
WHEREIS_PLAY_SERVICE_ACCOUNT_JSON=

# ---- Play real-time developer notifications (V11) ----
# The Pub/Sub push endpoint is POST https://<WHEREIS_API_HOST>/play/rtdn?key=<shared secret>.
# It can hand ANY account ANY tier and it is reachable by anyone on the internet, so it gets TWO
# INDEPENDENT checks and both must pass. All four variables are REQUIRED under the prod profile.
#
# 1) The shared secret, which is the ?key= of the push URL registered in the Play Console.
#    Generate it and NEVER reuse another secret:
#        openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
#    Caddy must not log it: deploy/Caddyfile.whereis has `log_skip` for /play/rtdn. If that is
#    left undone, this secret is written to disk on every notification and archived by the nightly
#    backup, and check 2 becomes the only real defence.
WHEREIS_PLAY_RTDN_SHARED_SECRET=
# 2) Google's OIDC push token. `google` verifies it; `fake` accepts one literal and is REFUSED under
#    the prod profile.
WHEREIS_PLAY_RTDN_VERIFIER=google
# The `aud` claim. MUST be the opaque audience you set EXPLICITLY on the Pub/Sub push subscription
# (see README Step 11) — never the push URL. Left blank in the Console, Google sets `aud` to the
# full endpoint URL including ?key=<the secret above>, and the app refuses to boot on a URL-shaped
# value rather than let you paste a secret into configuration and every startup log.
WHEREIS_PLAY_RTDN_AUDIENCE=whereis-rtdn
# The `email` claim: the service account the push subscription signs with.
WHEREIS_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=

# The three scheduled billing components (drift reconciler, refund sweep, cancellation janitor).
# ON by default. Turn them OFF on every container but one if whereis is ever scaled out: correctness
# survives, the Play quota spend doubles.
# WHEREIS_PLAY_RECONCILE_ENABLED=true
# WHEREIS_PLAY_VOIDED_SWEEP_ENABLED=true
# WHEREIS_PLAY_CANCELLATION_ENABLED=true

# ---- Tier limits (optional; see README Step 10) ----
# The numbers in application.yml ARE the product rule, so these are normally unset. They are also
# NOT forwarded by docker-compose.prod.yml by default. If you do use them, remember that the ladder
# must never go down: raising a LOWER tier means raising every tier above it, or startup fails with
# a message naming both keys. The old WHEREIS_LIMITS_FREE_* names bind NOTHING and are now a
# startup failure in their own right.
# WHEREIS_PLANS_FREE_SPACES=1
# WHEREIS_PLANS_FREE_ITEMS=100

# ---- Resources ----
WHEREIS_MEM_LIMIT=768m
